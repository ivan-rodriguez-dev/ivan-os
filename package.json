{
  "name": "ivan-os",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:e2e": "playwright test --trace off",
    "test:rls": "node --test --test-reporter=spec tests/security/rls.test.mjs",
    "stack:up": "bash dev-stack/up.sh",
    "stack:down": "docker compose -f dev-stack/docker-compose.yml down -v",
    "db:migrate:local": "bash dev-stack/migrate.sh"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
